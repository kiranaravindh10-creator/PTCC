# ─── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty in development to use the embedded PGlite database
# stored in .data/pglite (no PostgreSQL installation needed).
# Production requires a real PostgreSQL connection string.
DATABASE_URL=

# Optional: where the local PGlite database lives (default: .data/pglite)
# PGLITE_DATA_DIR=.data/pglite

# Only for trying a production build locally (`npm run build && npm start`)
# against PGlite. Never set this on a real deployment.
# PTCC_ALLOW_PGLITE_IN_PRODUCTION=true

# ─── AI-assisted lead capture (Phase 3 — docs/SYSTEM_ARCHITECTURE.md §7) ──────
# No real OCR / speech-to-text / extraction provider is connected yet.
#   simulated  built-in samples, clearly labelled — the default in development and tests
#   off        capture shows "not available yet" — always the case in production for now
# CAPTURE_PROVIDER=simulated

# ─── Future integrations (not used yet — see docs/SYSTEM_ARCHITECTURE.md §8) ─
# Phase 3/7 — real AI providers for capture and Ask PTCC (needs PTCC's approval first)
# ANTHROPIC_API_KEY=
# Phase 4 — Google Maps Platform (Places, Geocoding, Routes). Navigation links work without it.
# GOOGLE_MAPS_API_KEY=
# Phase 7 — WhatsApp Business Platform (Cloud API)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
